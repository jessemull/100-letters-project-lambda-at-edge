{
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "jose": "^6.2.8"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1105.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24 <25"
  },
  "main": "dist/index.js",
  "name": "auth-at-edge",
  "scripts": {
    "bastion": "node ./scripts/connect.js",
    "build": "webpack --config webpack.config.js",
    "clean": "rm -rf dist",
    "commit": "git-cz",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --fix",
    "lint:fix": "eslint . --fix",
    "package": "cd dist && zip -rq auth-at-edge.zip ./*",
    "prebuild": "npm run clean",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "token": "node ./scripts/cognito-token.js",
    "typecheck": "tsc --noEmit"
  },
  "version": "1.0.0"
}
